<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Media access, and the network for one optional thing only. INTERNET is here so that the user can copy their photos to a server they run themselves (Immich, Nextcloud): it is
        used by nothing else, and nothing connects anywhere until the user has allowed the network in the first-run screens (or later in Settings), set a server up and turned the
        backup on. Unencrypted traffic is refused outright (usesCleartextTraffic below). The build fails if any permission appears that is not on the reviewed list
        (VerifyNetworkPermissionsTask in build.gradle.kts, docs/PRIVACY.md). Deliberately absent: broad storage permissions, location services, accounts, anything of Google's.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14+: lets the user grant access to a hand-picked subset. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Asked for in the first-run screens (optional) or when the user asks to see a photo's location: Android redacts GPS otherwise. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!--
        WAKE_LOCK, ACCESS_NETWORK_STATE, FOREGROUND_SERVICE and RECEIVE_BOOT_COMPLETED are added by WorkManager (and Media3), which runs the background analysis and the optional backup
        and resumes them after a reboot. None of them allows network access by itself.
    -->

    <application
        android:name=".EikonApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="UnusedAttribute"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eikon.Starting"
        android:usesCleartextTraffic="false">

        <!-- WorkManager is initialized by EikonApplication so that workers can be injected with Hilt, which is why its own initializer is removed here; the emoji one is removed too (see below). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
            <!--
                Emoji support that looks for a font provider on the phone and, where Google Play services is installed, asks it to download an emoji font. eikon has no dependency on
                Google's services, and the system's own emoji are enough from Android 11 (the oldest release eikon runs on), so it is not started.
            -->
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <!--
            Hands another app the temporary picture of an edit that is being shared, and nothing else: it is not exported and only
            grants the one file named in each share (the folder is cache/shared, see SharedFiles).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                "Open with" for pictures: any app may ask eikon to show one picture it hands over (a content address). eikon reads only that
                picture, and only to show it. Videos are not offered.

                The two REVIEW actions are what camera apps send to show the photo just taken, so that eikon is offered (and can be made the default) for it. Some cameras
                leave the type out and send only the picture's MediaStore address, hence the second filter; eikon shows nothing that is not such an address (ExternalView).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="com.android.camera.action.REVIEW" />
                <action android:name="android.provider.action.REVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="com.android.camera.action.REVIEW" />
                <action android:name="android.provider.action.REVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="media" />
            </intent-filter>
        </activity>
    </application>

</manifest>
