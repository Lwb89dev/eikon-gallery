    <string name="analysis_places_progress">場所: %1$,d / %2$,d</string>
    <string name="analysis_semantic_progress">写っているもの: %1$,d / %2$,d</string>
    <string name="analysis_semantic_unavailable">写真に写っているものを認識するモデルを読み込めなかったため、この手順は実行されていません。</string>
