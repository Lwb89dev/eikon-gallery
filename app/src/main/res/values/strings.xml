    <string name="backup_secret_saved">Saved. Leave empty to keep it</string>
    <string name="backup_help_immich">In Immich: Account settings, API keys, New API key. The permission it needs is asset.upload.</string>
    <string name="backup_help_nextcloud">In Nextcloud: Personal settings, Security, Devices and sessions, create a new app password. Use that, not your login password.</string>
