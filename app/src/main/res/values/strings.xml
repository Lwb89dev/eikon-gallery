    <!-- Network consent -->
    <string name="network_allow">Allow eikon to use the internet</string>
    <string name="network_allow_note">Off unless you turn it on. eikon uses the network only to copy your photos to the server below, and only after you set one up and switch the backup on. With this off, nothing can connect anywhere.</string>
    <string name="settings_privacy_network">eikon can go online for one thing only: the optional backup of your photos to a server you run yourself. That is off until you allow it (Settings, Backup) and set the server up. No analytics, no ads, no accounts, no Google services, and no cloud of ours: there is none.</string>

    <!-- First-run screens -->
    <string name="onboarding_intro_title">Your photos, on your phone</string>
    <string name="onboarding_intro_body">eikon is a photo and video gallery for Android. It shows the pictures your phone already keeps, finds them by date, place, people or what they show, and edits them without ever touching the originals.</string>
    <string name="onboarding_point_local">Everything stays on this device. No account, no analytics, no ads.</string>
    <string name="onboarding_point_independent">It relies on nothing outside your phone: no Google services, no cloud, no third-party servers.</string>
    <string name="onboarding_point_yours">If you want a backup, it goes only to a server you run yourself, and only if you set it up.</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_start">Get started</string>
    <string name="onboarding_page">Page %1$d of %2$d</string>
    <string name="onboarding_permissions_title">What eikon asks for, and why</string>
    <string name="onboarding_permissions_intro">Only the first is needed. You can change any of them later, in Settings or in your phone\'s settings.</string>
    <string name="onboarding_perm_media_title">Photos and videos</string>
    <string name="onboarding_perm_media_body">So eikon can show your library. It reads the files where Android already keeps them and never copies them anywhere. You can allow just some photos if you prefer.</string>
    <string name="onboarding_perm_location_title">Photo locations (optional)</string>
    <string name="onboarding_perm_location_body">Android hides where a photo was taken from apps unless you allow this. eikon uses it to show a photo\'s place on an offline map and to search by place. Places are worked out on the phone: no position is ever sent anywhere.</string>
    <string name="onboarding_perm_network_title">Internet (optional)</string>
    <string name="onboarding_perm_network_body">Used for one thing only: copying your photos to a server you run yourself (Immich, Nextcloud), if you ever set that up. Otherwise eikon never connects to anything. It is off unless you turn it on here, and you can turn it off again at any time in Settings.</string>
    <string name="onboarding_allow">Allow</string>
    <string name="onboarding_allowed">Allowed</string>
    <string name="onboarding_promise">Nothing here depends on anything outside your phone: no Google services, no accounts, no analytics. Your photos stay on this device or, if you choose, go to your own server.</string>

