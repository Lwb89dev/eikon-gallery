    <!-- Backup to your own server -->
    <string name="backup_title">Backup to your own server</string>
    <string name="backup_intro">Copies your photos and videos to a server you run yourself, over an encrypted connection. Nothing leaves this phone until you turn the backup on, it goes only to the server below, and eikon never deletes or changes anything on it. The password or key is kept encrypted, in the Android Keystore.</string>
