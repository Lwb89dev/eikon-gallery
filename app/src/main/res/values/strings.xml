    <!-- Settings: security -->
    <string name="settings_security">Security</string>
    <string name="setting_lock_hidden">Require authentication for Hidden</string>
    <string name="setting_lock_trash">Require authentication for Recently deleted</string>
    <string name="setting_show_hidden">Show Hidden in Collections</string>
    <string name="settings_security_body">Hidden items are left out of the Library, Collections and search, and opening Hidden asks for your fingerprint, face or screen lock. The files themselves are not encrypted and stay in your phone\'s normal storage, where other apps with photo access can still see them.</string>

    <!-- Search -->
    <string name="search_placeholder">Date, place, text, file name</string>
    <string name="search_clear">Clear search</string>
    <string name="search_no_results">No photos match</string>
    <string name="search_hint_title">Search your library</string>
    <string name="search_hint_body">Try a date (\"August 2025\", \"yesterday\"), a place (\"Rome\", \"Tuscany\"), a word that appears in a photo or in its file name, or a kind (\"videos\", \"screenshots\", \"favorites\").\n\nSearch does not recognize what a picture shows yet, only what is written in it.</string>
    <string name="search_analysis_off">Searching by place, by text inside photos and by what they show is off. You can turn it on in Settings, Analysis.</string>
    <string name="search_analysis_note">Still analyzing photos in the background (%1$d%%). Some results may be missing.</string>

    <!-- Settings: analysis -->
    <string name="settings_analysis">Analysis</string>
    <string name="analysis_places_progress">Places: %1$,d of %2$,d</string>
    <string name="analysis_semantic_progress">What photos show: %1$,d of %2$,d</string>
    <string name="analysis_semantic_unavailable">The model that recognizes what photos show could not be loaded, so this step is not running.</string>
    <string name="search_semantic_unavailable">Searching by what photos show is unavailable right now (the model could not be loaded). Other results still work.</string>
    <string name="analysis_people_progress">People: %1$,d of %2$,d</string>
    <string name="analysis_people_unavailable">The models that find faces could not be loaded, so this step is not running.</string>
    <string name="analysis_duplicates_progress">Duplicates: %1$,d of %2$,d</string>
    <string name="analysis_text_progress">Text in photos: %1$,d of %2$,d</string>
    <string name="analysis_running">Analyzing now…</string>
    <string name="analysis_idle">Waiting for the right moment (charging, battery not low)</string>
    <string name="analysis_up_to_date">Everything is analyzed</string>
    <string name="setting_pause_analysis">Pause analysis</string>
    <string name="setting_only_charging">Only while charging</string>
    <string name="setting_analyze_places">Find photos by place</string>
    <string name="setting_analyze_semantic">Find photos by what they show</string>
    <string name="setting_analyze_people">Find people in photos</string>
    <string name="setting_analyze_people_note">Faces are found and compared on this phone only. Nothing about a face ever leaves it, and eikon never tries to recognize anyone: it only groups faces that look alike, and you name the groups.</string>
    <string name="setting_analyze_duplicates">Find duplicate photos</string>
    <string name="setting_analyze_text">Find text in photos</string>
    <string name="analysis_location_permission">Android hides where photos were taken from apps until you allow it.</string>
    <string name="analysis_allow_locations">Allow access to photo locations</string>
    <string name="analyze_now">Analyze now</string>
    <string name="settings_analysis_body">Analysis runs on your phone only, in the background, and pauses when the battery is low or the phone gets warm. It stores the place of each photo (resolved offline, no location is ever sent anywhere), a numeric description of what the photo shows (so you can search "dog" or "sunset"; it is not a caption and cannot be read back as an image) and any text it reads in the photo, so Search can find them. If you turn on people, it also stores where each face is in a photo and a numeric description of it, only to group faces that look alike. If you turn on duplicates, it stores a short fingerprint of each photo and of files that share a size, only to find copies. Recognizing what photos show and reading text are slow and use the processor heavily, which is why analysis waits for charging by default.</string>

