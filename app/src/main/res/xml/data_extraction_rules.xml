<?xml version="1.0" encoding="utf-8"?>
<!--
    The index database and settings describe the user's private library (file names, dates,
    later also faces/OCR/locations). None of it is uploaded to a cloud backup or copied to another
    device by the platform. Everything is rebuilt from MediaStore after a restore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
