<?xml version="1.0" encoding="utf-8"?>
<!--
    TLS only, and only the certificate authorities that ship with the phone. A server whose certificate is not from one of them (a home server with a
    self-signed or private certificate) is trusted by pinning that exact certificate in the app, after the user has compared its fingerprint (see
    docs/BACKUP.md); user-installed authorities are deliberately not trusted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
