    <!-- Network consent -->
    <string name="network_allow">Atļaut eikon izmantot internetu</string>
    <string name="network_allow_note">Izslēgts, kamēr tu neieslēdz. eikon izmanto tīklu tikai, lai kopētu tavus fotoattēlus uz zemāk norādīto serveri, un tikai pēc tam, kad esi iestatījis serveri un ieslēdzis dublēšanu. Kad tas ir izslēgts, nekas nevar nekur savienoties.</string>
    <string name="settings_privacy_network">eikon var iet tiešsaistē tikai vienam nolūkam: neobligātai tavu fotoattēlu dublēšanai uz serveri, ko tu uztur pats. Tā ir izslēgta, līdz tu to atļauj (Iestatījumi, Dublēšana) un iestati serveri. Nav lietojuma analītikas, nav reklāmu, nav kontu, nav Google pakalpojumu un nav mūsu mākoņa: tāda nav.</string>

    <!-- First-run screens -->
    <string name="onboarding_intro_title">Tavi fotoattēli, tavā tālrunī</string>
    <string name="onboarding_intro_body">eikon ir fotoattēlu un video galerija operētājsistēmai Android. Tā rāda attēlus, ko tavs tālrunis jau glabā, atrod tos pēc datuma, vietas, cilvēkiem vai tā, ko tie rāda, un rediģē tos, nekad neskarot oriģinālus.</string>
    <string name="onboarding_point_local">Viss paliek šajā ierīcē. Nav konta, nav lietojuma analītikas, nav reklāmu.</string>
    <string name="onboarding_point_independent">Tā nepaļaujas uz neko ārpus tava tālruņa: nav Google pakalpojumu, nav mākoņa, nav trešo pušu serveru.</string>
    <string name="onboarding_point_yours">Ja vēlies dublējumkopiju, tā iet tikai uz serveri, ko tu uztur pats, un tikai tad, ja to iestati.</string>
    <string name="onboarding_next">Tālāk</string>
    <string name="onboarding_start">Sākt</string>
    <string name="onboarding_page">%1$d. lappuse no %2$d</string>
    <string name="onboarding_permissions_title">Ko eikon lūdz un kāpēc</string>
    <string name="onboarding_permissions_intro">Nepieciešama ir tikai pirmā. Jebkuru no tām vari mainīt vēlāk Iestatījumos vai tālruņa iestatījumos.</string>
    <string name="onboarding_perm_media_title">Fotoattēli un video</string>
    <string name="onboarding_perm_media_body">Lai eikon varētu rādīt tavu bibliotēku. Tā lasa failus tur, kur Android tos jau glabā, un nekopē tos nekur. Ja vēlies, vari atļaut tikai dažus fotoattēlus.</string>
    <string name="onboarding_perm_location_title">Fotoattēlu atrašanās vietas (neobligāti)</string>
    <string name="onboarding_perm_location_body">Android slēpj no lietotnēm, kur fotoattēls uzņemts, ja vien tu to neatļauj. eikon to izmanto, lai rādītu fotoattēla vietu bezsaistes kartē un meklētu pēc vietas. Vietas tiek aprēķinātas tālrunī: neviena pozīcija netiek sūtīta nekur.</string>
    <string name="onboarding_perm_network_title">Internets (neobligāti)</string>
    <string name="onboarding_perm_network_body">Tiek izmantots vienam nolūkam: tavu fotoattēlu kopēšanai uz serveri, ko tu uztur pats (Immich, Nextcloud), ja to kādreiz iestatīsi. Citādi eikon nekad nesavienojas ne ar ko. Tas ir izslēgts, līdz tu to ieslēdz šeit, un vari to jebkurā laikā atkal izslēgt Iestatījumos.</string>
    <string name="onboarding_allow">Atļaut</string>
    <string name="onboarding_allowed">Atļauts</string>
    <string name="onboarding_promise">Nekas šeit nav atkarīgs no kaut kā ārpus tava tālruņa: nav Google pakalpojumu, nav kontu, nav lietojuma analītikas. Tavi fotoattēli paliek šajā ierīcē vai, ja tu tā izvēlies, iet uz tavu paša serveri.</string>

