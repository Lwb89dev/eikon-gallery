    <string name="analysis_text_progress">Text vo fotkách: %1$,d z %2$,d</string>
    <string name="analysis_running">Prebieha analýza…</string>
    <string name="analysis_idle">Čaká sa na vhodný okamih (batéria nie je slabá, Šetrič batérie je vypnutý a prípadne prebieha nabíjanie, ak ste to zvolili)</string>
    <string name="analysis_up_to_date">Všetko je analyzované</string>
    <string name="setting_pause_analysis">Pozastaviť analýzu</string>
    <string name="setting_only_charging">Len pri nabíjaní</string>
    <string name="setting_analyze_places">Hľadať fotky podľa miesta</string>
    <string name="setting_analyze_semantic">Hľadať fotky podľa toho, čo zobrazujú</string>
    <string name="setting_analyze_people">Hľadať ľudí na fotkách</string>
    <string name="setting_analyze_people_note">Tváre sa hľadajú a porovnávajú len v tomto telefóne. Nič o tvári ho nikdy neopustí a eikon sa nikdy nepokúša nikoho rozpoznať: iba zoskupuje tváre, ktoré sa podobajú, a skupiny pomenúvate vy.</string>
    <string name="setting_analyze_duplicates">Hľadať duplicitné fotky</string>
    <string name="setting_analyze_text">Hľadať text vo fotkách</string>
    <string name="analysis_location_permission">Android skrýva pred aplikáciami, kde boli fotky urobené, kým to nepovolíte.</string>
    <string name="analysis_allow_locations">Povoliť prístup k polohe fotiek</string>
    <string name="analyze_now">Analyzovať teraz</string>
    <string name="settings_analysis_body">Analýza beží len vo vašom telefóne, na pozadí, a pozastaví sa, keď je batéria slabá, je zapnutý Šetrič batérie alebo sa telefón zahreje („Analyzovať teraz“ pokračuje aj pri Šetriči batérie). Ukladá miesto každej fotky (určené offline, žiadna poloha sa nikdy nikam neodosiela), číselný popis toho, čo fotka zobrazuje (aby ste mohli hľadať „pes“ alebo „západ slnka“; nie je to popisok a nedá sa z neho spätne zložiť obrázok) a akýkoľvek text, ktorý vo fotke prečíta, aby ho Hľadanie mohlo nájsť. Ak zapnete ľudí, ukladá aj to, kde sa vo fotke nachádza každá tvár, a jej číselný popis, iba na zoskupenie podobných tvárí. Ak zapnete duplikáty, ukladá krátky odtlačok každej fotky a súborov s rovnakou veľkosťou, iba na nájdenie kópií. Rozpoznávanie toho, čo fotky zobrazujú, a čítanie textu sú pomalé a silne zaťažujú procesor, preto analýza predvolene čaká na nabíjanie.</string>

