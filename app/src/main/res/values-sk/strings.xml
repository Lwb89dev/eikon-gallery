    <!-- Network consent -->
    <string name="network_allow">Povoliť eikonu používať internet</string>
    <string name="network_allow_note">Vypnuté, kým to nezapnete. eikon používa sieť iba na kopírovanie vašich fotiek na server nižšie, a to až potom, ako nejaký nastavíte a zapnete zálohovanie. Keď je toto vypnuté, nič sa nemôže nikam pripojiť.</string>
    <string name="settings_privacy_network">eikon môže ísť online kvôli jedinej veci: voliteľnej záloze vašich fotiek na server, ktorý sami prevádzkujete. Tá je vypnutá, kým ju nepovolíte (Nastavenia, Záloha) a nenastavíte server. Žiadna analytika, žiadne reklamy, žiadne účty, žiadne služby Googlu a žiadny náš cloud: žiadny neexistuje.</string>

    <!-- First-run screens -->
    <string name="onboarding_intro_title">Vaše fotky, vo vašom telefóne</string>
    <string name="onboarding_intro_body">eikon je galéria fotiek a videí pre Android. Zobrazuje obrázky, ktoré váš telefón už uchováva, nájde ich podľa dátumu, miesta, ľudí alebo toho, čo zobrazujú, a upravuje ich bez toho, aby sa niekedy dotkol originálov.</string>
    <string name="onboarding_point_local">Všetko zostáva v tomto zariadení. Žiadny účet, žiadna analytika, žiadne reklamy.</string>
    <string name="onboarding_point_independent">Nespolieha sa na nič mimo vášho telefónu: žiadne služby Googlu, žiadny cloud, žiadne servery tretích strán.</string>
    <string name="onboarding_point_yours">Ak chcete zálohu, ide len na server, ktorý sami prevádzkujete, a len ak ju nastavíte.</string>
    <string name="onboarding_next">Ďalej</string>
    <string name="onboarding_start">Začať</string>
    <string name="onboarding_page">Strana %1$d z %2$d</string>
    <string name="onboarding_permissions_title">O čo eikon žiada a prečo</string>
    <string name="onboarding_permissions_intro">Potrebné je len prvé. Ktorékoľvek z nich môžete neskôr zmeniť v Nastaveniach alebo v nastaveniach telefónu.</string>
    <string name="onboarding_perm_media_title">Fotky a videá</string>
    <string name="onboarding_perm_media_body">Aby eikon mohol zobraziť vašu knižnicu. Číta súbory tam, kde ich Android už uchováva, a nikam ich nekopíruje. Ak chcete, môžete povoliť len niektoré fotky.</string>
    <string name="onboarding_perm_location_title">Poloha fotiek (voliteľné)</string>
    <string name="onboarding_perm_location_body">Android skrýva pred aplikáciami, kde bola fotka urobená, ak to nepovolíte. eikon to používa na zobrazenie miesta fotky na offline mape a na vyhľadávanie podľa miesta. Miesta sa určujú v telefóne: žiadna poloha sa nikdy nikam neodosiela.</string>
    <string name="onboarding_perm_network_title">Internet (voliteľné)</string>
    <string name="onboarding_perm_network_body">Používa sa len na jednu vec: kopírovanie vašich fotiek na server, ktorý sami prevádzkujete (Immich, Nextcloud), ak to niekedy nastavíte. Inak sa eikon k ničomu nepripája. Je to vypnuté, kým to tu nezapnete, a kedykoľvek to môžete v Nastaveniach znova vypnúť.</string>
    <string name="onboarding_allow">Povoliť</string>
    <string name="onboarding_allowed">Povolené</string>
    <string name="onboarding_promise">Nič tu nezávisí od ničoho mimo vášho telefónu: žiadne služby Googlu, žiadne účty, žiadna analytika. Vaše fotky zostávajú v tomto zariadení alebo, ak sa tak rozhodnete, idú na váš vlastný server.</string>

