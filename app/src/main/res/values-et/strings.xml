    <!-- First-run screens -->
    <string name="onboarding_intro_title">Sinu fotod, sinu telefonis</string>
    <string name="onboarding_intro_body">eikon on foto- ja videogalerii Androidile. See kuvab pildid, mida sinu telefon juba säilitab, leiab need kuupäeva, koha, inimeste või kujutatu järgi ning muudab neid, puudutamata kunagi originaale.</string>
    <string name="onboarding_point_local">Kõik jääb sellesse seadmesse. Ei kontot, ei kasutusanalüütikat, ei reklaame.</string>
    <string name="onboarding_point_independent">See ei toetu millelegi väljaspool sinu telefoni: ei Google’i teenuseid, ei pilve, ei kolmandate osapoolte servereid.</string>
    <string name="onboarding_point_yours">Kui soovid varukoopiat, läheb see ainult serverisse, mida sa ise haldad, ja ainult siis, kui sa selle seadistad.</string>
    <string name="onboarding_next">Edasi</string>
    <string name="onboarding_start">Alusta</string>
    <string name="onboarding_page">Leht %1$d / %2$d</string>
    <string name="onboarding_permissions_title">Mida eikon küsib ja miks</string>
    <string name="onboarding_permissions_intro">Vaja on ainult esimest. Igaüht neist saad hiljem muuta Seadetes või telefoni seadetes.</string>
    <string name="onboarding_perm_media_title">Fotod ja videod</string>
    <string name="onboarding_perm_media_body">Et eikon saaks sinu kogu kuvada. See loeb faile seal, kus Android neid juba säilitab, ega kopeeri neid kuhugi. Soovi korral võid lubada vaid mõned fotod.</string>
    <string name="onboarding_perm_location_title">Fotode asukohad (valikuline)</string>
    <string name="onboarding_perm_location_body">Android peidab rakenduste eest, kus foto on tehtud, kui sa seda ei luba. eikon kasutab seda foto koha näitamiseks võrguühenduseta kaardil ja koha järgi otsimiseks. Kohad arvutatakse telefonis: ühtegi asukohta ei saadeta kunagi kuhugi.</string>
    <string name="onboarding_perm_network_title">Internet (valikuline)</string>
    <string name="onboarding_perm_network_body">Kasutatakse ainult ühe asja jaoks: sinu fotode kopeerimiseks serverisse, mida sa ise haldad (Immich, Nextcloud), kui sa selle kunagi seadistad. Muidu ei ühendu eikon kunagi millegagi. See on väljas, kuni lülitad selle siin sisse, ja saad selle igal ajal Seadetes uuesti välja lülitada.</string>
    <string name="onboarding_allow">Luba</string>
    <string name="onboarding_allowed">Lubatud</string>
    <string name="onboarding_promise">Miski siin ei sõltu millestki väljaspool sinu telefoni: ei Google’i teenuseid, ei kontosid, ei kasutusanalüütikat. Sinu fotod jäävad sellesse seadmesse või lähevad, kui nii valid, sinu enda serverisse.</string>

