    <!-- Search -->
    <string name="search_placeholder">Datum, místo, text, název souboru</string>
    <string name="search_clear">Vymazat hledání</string>
    <string name="search_no_results">Žádné fotky neodpovídají</string>
    <string name="search_hint_title">Hledejte v knihovně</string>
    <string name="search_hint_body">Zkuste datum („August 2025“, „yesterday“), místo („Rome“, „Tuscany“), slovo, které se objevuje na fotce nebo v názvu souboru, nebo druh („videos“, „screenshots“, „favorites“).\n\nData a druhy se rozpoznávají v angličtině a italštině. Místa, text ve fotkách a to, co zobrazují, se najdou po proběhnutí analýzy (Nastavení, Analýza).</string>
    <string name="search_analysis_off">Vyhledávání podle místa, textu ve fotkách a toho, co zobrazují, je vypnuto. Můžete ho zapnout v Nastavení, Analýza.</string>
    <string name="search_analysis_note">Fotky se na pozadí stále analyzují (%1$d %%). Některé výsledky mohou chybět.</string>

