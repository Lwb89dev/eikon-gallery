    <!-- Network consent -->
    <string name="network_allow">Povolit eikonu používat internet</string>
    <string name="network_allow_note">Vypnuto, dokud to nezapnete. eikon používá síť jen ke kopírování vašich fotek na server níže, a to až poté, co nějaký nastavíte a zapnete zálohování. Když je toto vypnuto, nic se nemůže nikam připojit.</string>
    <string name="settings_privacy_network">eikon může jít online jen kvůli jedné věci: volitelné záloze vašich fotek na server, který sami provozujete. Ta je vypnutá, dokud ji nepovolíte (Nastavení, Záloha) a nenastavíte server. Žádná analytika, žádné reklamy, žádné účty, žádné služby Googlu a žádný náš cloud: žádný neexistuje.</string>

    <!-- First-run screens -->
    <string name="onboarding_intro_title">Vaše fotky, ve vašem telefonu</string>
    <string name="onboarding_intro_body">eikon je galerie fotek a videí pro Android. Zobrazuje obrázky, které váš telefon už uchovává, najde je podle data, místa, lidí nebo toho, co zobrazují, a upravuje je, aniž by se kdy dotkl originálů.</string>
    <string name="onboarding_point_local">Vše zůstává v tomto zařízení. Žádný účet, žádná analytika, žádné reklamy.</string>
    <string name="onboarding_point_independent">Nespoléhá na nic mimo váš telefon: žádné služby Googlu, žádný cloud, žádné servery třetích stran.</string>
    <string name="onboarding_point_yours">Pokud chcete zálohu, jde jen na server, který sami provozujete, a jen pokud ji nastavíte.</string>
    <string name="onboarding_next">Další</string>
    <string name="onboarding_start">Začít</string>
    <string name="onboarding_page">Strana %1$d z %2$d</string>
    <string name="onboarding_permissions_title">O co eikon žádá a proč</string>
    <string name="onboarding_permissions_intro">Potřebné je jen první. Kterékoli z nich můžete později změnit v Nastavení nebo v nastavení telefonu.</string>
    <string name="onboarding_perm_media_title">Fotky a videa</string>
    <string name="onboarding_perm_media_body">Aby eikon mohl zobrazit vaši knihovnu. Čte soubory tam, kde je Android už uchovává, a nekopíruje je nikam. Pokud chcete, můžete povolit jen některé fotky.</string>
    <string name="onboarding_perm_location_title">Poloha fotek (volitelné)</string>
    <string name="onboarding_perm_location_body">Android skrývá před aplikacemi, kde byla fotka pořízena, pokud to nepovolíte. eikon to používá k zobrazení místa fotky na offline mapě a k vyhledávání podle místa. Místa se určují v telefonu: žádná poloha se nikdy nikam neodesílá.</string>
    <string name="onboarding_perm_network_title">Internet (volitelné)</string>
    <string name="onboarding_perm_network_body">Používá se jen k jedné věci: kopírování vašich fotek na server, který sami provozujete (Immich, Nextcloud), pokud to někdy nastavíte. Jinak se eikon k ničemu nepřipojuje. Je to vypnuto, dokud to tady nezapnete, a kdykoli to můžete v Nastavení znovu vypnout.</string>
    <string name="onboarding_allow">Povolit</string>
    <string name="onboarding_allowed">Povoleno</string>
    <string name="onboarding_promise">Nic tu nezávisí na ničem mimo váš telefon: žádné služby Googlu, žádné účty, žádná analytika. Vaše fotky zůstávají v tomto zařízení nebo, pokud se tak rozhodnete, jdou na váš vlastní server.</string>

